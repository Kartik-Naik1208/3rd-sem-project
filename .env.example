# Flask Environment Configuration
FLASK_APP=run.py
FLASK_ENV=development
FLASK_DEBUG=1
SECRET_KEY=dev-secret-key-change-in-production-1234567890
DATABASE_URL=sqlite:///instance/ingredientiq.db

# Base Application URL for links (prevents Host header manipulation)
# In production on Render: https://ingredientiq-cymt.onrender.com
APP_BASE_URL=https://ingredientiq-cymt.onrender.com

# Gmail SMTP Email Configuration for Password Resets
# 1. Enable 2-Step Verification on your Google Account: https://myaccount.google.com/security
# 2. Generate an App Password under Security -> 2-Step Verification -> App passwords
# 3. Paste the generated 16-character password into MAIL_PASSWORD
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USE_TLS=true
MAIL_USE_SSL=false
MAIL_USERNAME=your-account@gmail.com
MAIL_PASSWORD=your-16-char-app-password
MAIL_DEFAULT_SENDER=your-account@gmail.com

# Optional Tesseract OCR path (adjust if Tesseract is installed in custom path)
# Windows example: C:\Program Files\Tesseract-OCR\tesseract.exe
# Linux example: /usr/bin/tesseract
# Mac example: /opt/homebrew/bin/tesseract
TESSERACT_CMD=
